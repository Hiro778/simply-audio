<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="IvoryIsland.Controls.TrafficLightControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="TrafficLightCircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="CornerRadius" Value="6.5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center"
                PointerEntered="OnContainerPointerEntered"
                PointerExited="OnContainerPointerExited">

        <!-- Red Close Button -->
        <Button x:Name="CloseButton"
                Style="{StaticResource TrafficLightCircleButtonStyle}"
                Background="{StaticResource TrafficLightRedBrush}"
                BorderBrush="#26000000"
                Click="OnCloseButtonClick"
                ToolTipService.ToolTip="Close Window"
                AutomationProperties.Name="Close Window">
            <TextBlock x:Name="CloseGlyph"
                       Text="×"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#804D0000"
                       Margin="0,-2,0,0"
                       Opacity="0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Button>

        <!-- Yellow Minimize Button -->
        <Button x:Name="MinimizeButton"
                Style="{StaticResource TrafficLightCircleButtonStyle}"
                Background="{StaticResource TrafficLightYellowBrush}"
                BorderBrush="#26000000"
                Click="OnMinimizeButtonClick"
                ToolTipService.ToolTip="Minimize Window"
                AutomationProperties.Name="Minimize Window">
            <TextBlock x:Name="MinimizeGlyph"
                       Text="–"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="#805C4000"
                       Margin="0,-3,0,0"
                       Opacity="0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Button>

        <!-- Green Maximize / Restore Button -->
        <Button x:Name="MaximizeButton"
                Style="{StaticResource TrafficLightCircleButtonStyle}"
                Background="{StaticResource TrafficLightGreenBrush}"
                BorderBrush="#26000000"
                Click="OnMaximizeButtonClick"
                DoubleTapped="OnMaximizeButtonDoubleTapped"
                ToolTipService.ToolTip="Maximize / Restore Window (Double-click for Fullscreen)"
                AutomationProperties.Name="Maximize or Restore Window">
            <TextBlock x:Name="MaximizeGlyph"
                       Text="+"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="#800A4D1A"
                       Margin="0,-2,0,0"
                       Opacity="0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Button>
    </StackPanel>
</UserControl>
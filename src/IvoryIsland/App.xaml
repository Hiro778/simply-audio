<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="IvoryIsland.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/GlassTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Compatibility fallback keys aligned to White Frosted Glass -->
            <Color x:Key="IvorySeparatorColor">#33CBD5E1</Color>
            <Color x:Key="IvoryMutedAccentColor">#C9C4E8</Color>
            <Color x:Key="IvoryActiveSliderFillColor">#8B5CF6</Color>
            <Color x:Key="IvoryControlBackgroundColor">#80F1F5F9</Color>

            <SolidColorBrush x:Key="IvorySeparatorBrush" Color="{StaticResource IvorySeparatorColor}" />
            <SolidColorBrush x:Key="IvoryMutedAccentBrush" Color="{StaticResource IvoryMutedAccentColor}" />
            <SolidColorBrush x:Key="IvoryActiveSliderFillBrush" Color="{StaticResource IvoryActiveSliderFillColor}" />
            <SolidColorBrush x:Key="IvoryControlBackgroundBrush" Color="{StaticResource IvoryControlBackgroundColor}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
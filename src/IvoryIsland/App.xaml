<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="IvoryIsland.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Minimal Ivory Liquid Glass Palette (#F7F5EF, #FDFCF8, #242321, #77756F, #FFFFFF, #DCDAD3, #C9C4E8, #EAE8E1) -->
            <Color x:Key="IvoryGlassBackgroundColor">#EBF7F5EF</Color>
            <Color x:Key="IvoryGlassSecondaryColor">#FDFCF8</Color>
            <Color x:Key="IvoryPrimaryTextColor">#242321</Color>
            <Color x:Key="IvorySecondaryTextColor">#77756F</Color>
            <Color x:Key="IvoryBorderColor">#FFFFFF</Color>
            <Color x:Key="IvorySeparatorColor">#DCDAD3</Color>
            <Color x:Key="IvoryMutedAccentColor">#C9C4E8</Color>
            <Color x:Key="IvoryActiveSliderFillColor">#8B7CE8</Color>
            <Color x:Key="IvoryControlBackgroundColor">#EAE8E1</Color>
            <Color x:Key="SpotifyBrandGreenColor">#1ED760</Color>

            <SolidColorBrush x:Key="IvoryGlassBackgroundBrush" Color="{StaticResource IvoryGlassBackgroundColor}" />
            <SolidColorBrush x:Key="IvoryGlassSecondaryBrush" Color="{StaticResource IvoryGlassSecondaryColor}" />
            <SolidColorBrush x:Key="IvoryPrimaryTextBrush" Color="{StaticResource IvoryPrimaryTextColor}" />
            <SolidColorBrush x:Key="IvorySecondaryTextBrush" Color="{StaticResource IvorySecondaryTextColor}" />
            <SolidColorBrush x:Key="IvoryBorderBrush" Color="{StaticResource IvoryBorderColor}" />
            <SolidColorBrush x:Key="IvorySeparatorBrush" Color="{StaticResource IvorySeparatorColor}" />
            <SolidColorBrush x:Key="IvoryMutedAccentBrush" Color="{StaticResource IvoryMutedAccentColor}" />
            <SolidColorBrush x:Key="IvoryActiveSliderFillBrush" Color="{StaticResource IvoryActiveSliderFillColor}" />
            <SolidColorBrush x:Key="IvoryControlBackgroundBrush" Color="{StaticResource IvoryControlBackgroundColor}" />
            <SolidColorBrush x:Key="SpotifyBrandGreenBrush" Color="{StaticResource SpotifyBrandGreenColor}" />

            <FontFamily x:Key="IvoryPrimaryFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>

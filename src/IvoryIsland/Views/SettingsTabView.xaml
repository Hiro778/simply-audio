<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="IvoryIsland.Views.SettingsTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource IvoryPrimaryFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,24,32,32" Spacing="20" MaxWidth="800" HorizontalAlignment="Center">

            <!-- Card 0: Full Desktop Transformation (macOS Experience) -->
            <Border CornerRadius="20"
                    Background="{StaticResource IvoryGlassSurfaceBrush}"
                    BorderBrush="{StaticResource IvoryBorderBrush}"
                    BorderThickness="1.2"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Full Desktop Transformation" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource IvoryPrimaryTextBrush}" />
                    <TextBlock Text="Transforms Windows into a premium macOS-inspired frosted white glass desktop with global menu bar, dock, and control center." FontSize="11" Foreground="{StaticResource IvorySecondaryTextBrush}" />

                    <!-- Operating Mode Selector -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Desktop Operating Mode" FontSize="13" FontWeight="Medium" Foreground="{StaticResource IvoryPrimaryTextBrush}" />
                            <TextBlock Text="Immersive (Menu bar + Dock primary) or Standard (traditional Windows taskbar)" FontSize="11" Foreground="{StaticResource IvorySecondaryTextBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="OperatingModeComboBox"
                                  Grid.Column="1"
                                  Width="180"
                                  SelectionChanged="OnOperatingModeSelectionChanged">
                            <ComboBoxItem Content="Immersive Desktop" Tag="Immersive" />
                            <ComboBoxItem Content="Standard Windows" Tag="Standard" />
                        </ComboBox>
                    </Grid>

                    <CheckBox x:Name="DockMagnificationCheckBox"
                              Content="Enable smooth macOS Dock hover magnification"
                              FontSize="12"
                              Click="OnDockMagnificationCheckBoxClick" />

                    <CheckBox x:Name="ShowMediaInMenuBarCheckBox"
                              Content="Show Now Playing media pill in the global menu bar"
                              FontSize="12"
                              Click="OnShowMediaInMenuBarCheckBoxClick" />

                    <CheckBox x:Name="ShowVolumeHudCheckBox"
                              Content="Show bezel Volume HUD on WASAPI system volume changes"
                              FontSize="12"
                              Click="OnShowVolumeHudCheckBoxClick" />

                    <!-- Emergency Recovery Info Box -->
                    <Border CornerRadius="12"
                            Background="{StaticResource IvoryAccentIceBlueBrush}"
                            Padding="14,10,14,10"
                            Margin="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE783;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource IvoryPrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Emergency Desktop Recovery: Press Ctrl+Alt+Escape" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource IvoryPrimaryTextBrush}" />
                                <TextBlock Text="Instantly recovers the Windows taskbar, Explorer, and task manager if needed." FontSize="10.5" Foreground="{StaticResource IvorySecondaryTextBrush}" />
                            </StackPanel>
                            <Button x:Name="OpenTaskbarSettingsButton"
                                    Grid.Column="2"
                                    Content="Taskbar Settings"
                                    Style="{StaticResource GlassPillButtonStyle}"
                                    Padding="10,4,10,4"
                                    Click="OnOpenTaskbarSettingsButtonClick" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 1: Appearance & Glass Materials -->
            <Border CornerRadius="20"
                    Background="{StaticResource IvoryGlassSurfaceBrush}"
                    BorderBrush="{StaticResource IvoryBorderBrush}"
                    BorderThickness="1.2"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Appearance &amp; Glass System" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource IvoryPrimaryTextBrush}" />

                    <!-- Glass Opacity Slider -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Frosted Glass Opacity" FontSize="13" FontWeight="Medium" Foreground="{StaticResource IvoryPrimaryTextBrush}" />
                            <TextBlock Text="Translucent pearl-white glass with subtle lavender and ice-blue reflections" FontSize="11" Foreground="{StaticResource IvorySecondaryTextBrush}" />
                        </StackPanel>
                        <Slider x:Name="GlassOpacitySlider"
                                Grid.Column="1"
                                Width="140"
                                Minimum="65"
                                Maximum="98"
                                Value="90"
                                Foreground="{StaticResource IvoryAccentVioletBrush}"
                                ValueChanged="OnGlassOpacitySliderValueChanged" />
                        <TextBlock x:Name="GlassOpacityLabel"
                                   Grid.Column="2"
                                   Text="90%"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource IvoryPrimaryTextBrush}"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: Island & Window Behavior -->
            <Border CornerRadius="20"
                    Background="{StaticResource IvoryGlassSecondaryBrush}"
                    BorderBrush="{StaticResource IvoryBorderBrush}"
                    BorderThickness="1"
                    Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Text="Window &amp; Overlay Behavior" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource IvoryPrimaryTextBrush}" />

                    <CheckBox x:Name="StartWithWindowsCheckBox"
                              Content="Start Ivory Island automatically with Windows"
                              FontSize="12"
                              Click="OnStartWithWindowsCheckBoxClick" />

                    <CheckBox x:Name="FullscreenAutoHideCheckBox"
                              Content="Auto-hide floating overlay when a full-screen application is active"
                              FontSize="12"
                              Click="OnFullscreenAutoHideCheckBoxClick" />

                    <CheckBox x:Name="CompactIdleCheckBox"
                              Content="Keep compact minimal capsule when audio playback is idle"
                              FontSize="12"
                              Click="OnCompactIdleCheckBoxClick" />

                    <!-- Placement & Anchoring -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Floating Mini Controller Anchor" FontSize="13" FontWeight="Medium" Foreground="{StaticResource IvoryPrimaryTextBrush}" />
                            <TextBlock Text="Position along the top work area of the active screen" FontSize="11" Foreground="{StaticResource IvorySecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Content="Left" Style="{StaticResource GlassPillButtonStyle}" Padding="10,4,10,4" Click="OnAnchorLeftClick" />
                            <Button Content="Center" Style="{StaticResource GlassPillButtonStyle}" Padding="10,4,10,4" Click="OnAnchorCenterClick" />
                            <Button Content="Right" Style="{StaticResource GlassPillButtonStyle}" Padding="10,4,10,4" Click="OnAnchorRightClick" />
                            <Button Content="Reset Position" Style="{StaticResource GlassPillButtonStyle}" Padding="10,4,10,4" Click="OnResetPositionClick" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 3: User Data & Cache Storage -->
            <Border CornerRadius="20"
                    Background="{StaticResource IvoryGlassSecondaryBrush}"
                    BorderBrush="{StaticResource IvoryBorderBrush}"
                    BorderThickness="1"
                    Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Text="Data Storage &amp; Cache Location" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource IvoryPrimaryTextBrush}" />
                    <TextBlock Text="Custom directory for cached album thumbnails, diagnostics, and settings. Separated from binary files." FontSize="11" Foreground="{StaticResource IvorySecondaryTextBrush}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Height="34"
                                CornerRadius="10"
                                Background="{StaticResource IvoryGlassSurfaceBrush}"
                                BorderBrush="{StaticResource IvoryBorderSubtleBrush}"
                                BorderThickness="1"
                                Padding="12,0,12,0">
                            <TextBlock x:Name="DataDirectoryTextBlock"
                                       Text="%LOCALAPPDATA%\IvoryIsland"
                                       FontSize="12"
                                       Foreground="{StaticResource IvoryPrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Border>

                        <Button x:Name="BrowseDataFolderButton"
                                Grid.Column="1"
                                Content="Browse..."
                                Style="{StaticResource GlassPillButtonStyle}"
                                Height="34"
                                Padding="12,0,12,0"
                                Click="OnBrowseDataFolderButtonClick" />

                        <Button x:Name="ResetDataFolderButton"
                                Grid.Column="2"
                                Content="Default"
                                Style="{StaticResource GlassPillButtonStyle}"
                                Height="34"
                                Padding="12,0,12,0"
                                Click="OnResetDataFolderButtonClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 4: About Ivory Island -->
            <Border CornerRadius="20"
                    Background="{StaticResource IvoryGlassSurfaceBrush}"
                    BorderBrush="{StaticResource IvoryBorderBrush}"
                    BorderThickness="1"
                    Padding="24">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="{StaticResource IvoryAccentLavenderBrush}">
                        <FontIcon Glyph="&#xE7F4;" FontSize="22" Foreground="{StaticResource IvoryAccentVioletDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Ivory Island" FontSize="16" FontWeight="Bold" Foreground="{StaticResource IvoryPrimaryTextBrush}" />
                        <TextBlock Text="Version 1.0.0 — macOS-Inspired White Frosted Glass Experience" FontSize="12" Foreground="{StaticResource IvorySecondaryTextBrush}" />
                        <TextBlock Text=".NET 8.0 • Windows App SDK 1.6 • WinUI 3 • Windows Composition • WASAPI" FontSize="11" Foreground="{StaticResource IvoryTertiaryTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IvoryIsland.Views.VolumeHudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ivory Desktop Volume HUD">

    <Grid Background="Transparent">
        <!-- Bezel Card -->
        <Border x:Name="HudBorder"
                Width="210"
                Height="56"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="18"
                Background="{StaticResource VolumeHudGlassBrush}"
                BorderBrush="{StaticResource LuminousRimBorderBrush}"
                BorderThickness="1.2">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>

            <Grid Padding="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Speaker Glyph -->
                <TextBlock x:Name="HudSpeakerGlyph"
                           Grid.Column="0"
                           Text="&#xE995;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="18"
                           Foreground="{StaticResource IvoryPrimaryTextBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />

                <!-- Volume Bar -->
                <ProgressBar x:Name="HudProgressBar"
                             Grid.Column="1"
                             Minimum="0"
                             Maximum="100"
                             Value="50"
                             Height="6"
                             CornerRadius="3"
                             Foreground="{StaticResource IvoryAccentVioletBrush}"
                             Background="{StaticResource IvoryGlassSecondaryBrush}"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>

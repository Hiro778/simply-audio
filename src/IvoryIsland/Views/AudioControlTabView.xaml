<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="IvoryIsland.Views.AudioControlTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource IvoryPrimaryFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,24,32,32" Spacing="20" MaxWidth="800" HorizontalAlignment="Center">

            <!-- Card 1: Master System Audio Endpoint -->
            <Border CornerRadius="20"
                    Background="{StaticResource IvoryGlassSurfaceBrush}"
                    BorderBrush="{StaticResource IvoryBorderBrush}"
                    BorderThickness="1.2"
                    Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource IvoryAccentLavenderBrush}">
                                <FontIcon Glyph="&#xE995;" FontSize="16" Foreground="{StaticResource IvoryAccentVioletDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Master System Audio" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource IvoryPrimaryTextBrush}" />
                                <TextBlock Text="Default WASAPI Audio Output" FontSize="12" Foreground="{StaticResource IvorySecondaryTextBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Mute Toggle Button -->
                        <Button x:Name="MuteMasterButton"
                                Style="{StaticResource GlassPillButtonStyle}"
                                HorizontalAlignment="Right"
                                Click="OnMuteMasterButtonClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="MuteStatusIcon" Glyph="&#xE995;" FontSize="13" />
                                <TextBlock x:Name="MuteStatusText" Text="Active" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Large Volume Slider & Readout -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>

                        <Slider x:Name="MasterVolumeSlider"
                                Grid.Column="0"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                Foreground="{StaticResource IvoryAccentVioletBrush}"
                                ValueChanged="OnMasterVolumeSliderValueChanged" />

                        <TextBlock x:Name="VolumePercentageLabel"
                                   Grid.Column="1"
                                   Text="70%"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource IvoryPrimaryTextBrush}"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right" />
                    </Grid>

                    <!-- Preset Pills -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <TextBlock Text="Presets:" FontSize="12" Foreground="{StaticResource IvorySecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Button Content="Mute" FontSize="11" Style="{StaticResource GlassPillButtonStyle}" Padding="10,4,10,4" Click="OnPresetMuteClick" />
                        <Button Content="25%" FontSize="11" Style="{StaticResource GlassPillButtonStyle}" Padding="10,4,10,4" Click="OnPreset25Click" />
                        <Button Content="50%" FontSize="11" Style="{StaticResource GlassPillButtonStyle}" Padding="10,4,10,4" Click="OnPreset50Click" />
                        <Button Content="75%" FontSize="11" Style="{StaticResource GlassPillButtonStyle}" Padding="10,4,10,4" Click="OnPreset75Click" />
                        <Button Content="100%" FontSize="11" Style="{StaticResource GlassPillButtonStyle}" Padding="10,4,10,4" Click="OnPreset100Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: WASAPI Stream & Architecture Details -->
            <Border CornerRadius="20"
                    Background="{StaticResource IvoryGlassSecondaryBrush}"
                    BorderBrush="{StaticResource IvoryBorderBrush}"
                    BorderThickness="1"
                    Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Text="Audio Architecture &amp; Integration" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource IvoryPrimaryTextBrush}" />

                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" CornerRadius="12" Background="{StaticResource IvoryGlassSurfaceBrush}" Padding="14,10,14,10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Control Subsystem" FontSize="11" Foreground="{StaticResource IvorySecondaryTextBrush}" />
                                <TextBlock Text="WASAPI Core Audio COM" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource IvoryPrimaryTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" CornerRadius="12" Background="{StaticResource IvoryGlassSurfaceBrush}" Padding="14,10,14,10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Session Notifications" FontSize="11" Foreground="{StaticResource IvorySecondaryTextBrush}" />
                                <TextBlock Text="Event-Driven (Zero Polling)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource IvoryPrimaryTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" CornerRadius="12" Background="{StaticResource IvoryGlassSurfaceBrush}" Padding="14,10,14,10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Hardware Acceleration" FontSize="11" Foreground="{StaticResource IvorySecondaryTextBrush}" />
                                <TextBlock Text="Direct Windows Audio Endpoints" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource IvoryPrimaryTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" CornerRadius="12" Background="{StaticResource IvoryGlassSurfaceBrush}" Padding="14,10,14,10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Target Compatibility" FontSize="11" Foreground="{StaticResource IvorySecondaryTextBrush}" />
                                <TextBlock Text="Windows 10 22H2 &amp; Windows 11" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource IvoryPrimaryTextBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
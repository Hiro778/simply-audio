<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="IvoryIsland.Views.FloatingIslandView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IvoryIsland.Controls"
    xmlns:models="using:IvoryIsland.Models"
    FontFamily="{StaticResource IvoryPrimaryFont}">

    <UserControl.Resources>
        <Style x:Key="CapsuleIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource IvoryPrimaryTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FloatingPlayPauseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="Background" Value="#F2FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource IvoryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Foreground" Value="{StaticResource IvoryPrimaryTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DismissCircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{StaticResource IvoryGlassHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource IvoryBorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource IvoryPrimaryTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootLayoutGrid"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Padding="8,4,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- FLOATING GLASS MEDIA CONTROLLER (Reference Image 2) -->
        <Border x:Name="MainCapsuleBorder"
                Grid.Row="0"
                Height="68"
                CornerRadius="34"
                Background="{StaticResource IvoryGlassBackgroundBrush}"
                BorderBrush="{StaticResource LuminousRimBorderBrush}"
                BorderThickness="1.2"
                Padding="10,0,12,0"
                PointerPressed="OnDragSurfacePointerPressed"
                PointerMoved="OnDragSurfacePointerMoved"
                PointerReleased="OnDragSurfacePointerReleased"
                DoubleTapped="OnCapsuleDoubleTapped"
                ToolTipService.ToolTip="Ivory Island Floating Media Controller (Drag to move, Double-click to center)">

            <Grid x:Name="CapsuleContentGrid" VerticalAlignment="Center" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <!-- 0: Source App Indicator (Spotify / Browser) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 1: Artwork -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 2: Track Metadata -->
                    <ColumnDefinition Width="190" />
                    <!-- 3: Transport Controls -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 4: Waveform / Equalizer Visualizer -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 5: Volume Slider & Readout -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 6: Dismiss 'X' Button -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- SECTION 0: SOURCE APP BADGE (e.g. Spotify green circle with chevron 'v') -->
                <Button x:Name="SourceDropdownButton"
                        Grid.Column="0"
                        Height="34"
                        CornerRadius="17"
                        Background="{StaticResource IvoryGlassSecondaryBrush}"
                        BorderBrush="{StaticResource IvoryBorderSubtleBrush}"
                        BorderThickness="1"
                        Padding="6,0,8,0"
                        Click="OnSourceDropdownToggleClick"
                        ToolTipService.ToolTip="Switch Media Source"
                        AutomationProperties.Name="Switch Media Source">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <!-- Spotify Brand Icon -->
                        <Grid x:Name="SpotifyIconGrid" Width="22" Height="22">
                            <Ellipse Fill="#1ED760" />
                            <Path Data="M 5.5,8.8 C 8.6,7.8 13.2,8.0 16.2,9.7 M 6.4,11.7 C 8.9,10.9 12.5,11.1 15.0,12.5 M 7.3,14.4 C 9.4,13.7 12.0,13.9 13.9,15.0"
                                  Stroke="#202333"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Grid>

                        <!-- Browser Badge Icon (fallback) -->
                        <Grid x:Name="BrowserIconGrid" Width="22" Height="22" Visibility="Collapsed">
                            <Ellipse Fill="#E62117" />
                            <Polygon Points="9,7 9,15 15,11" Fill="#FFFFFF" />
                        </Grid>

                        <!-- Generic App Icon (fallback) -->
                        <FontIcon x:Name="GenericSourceIcon" Glyph="&#xEC4F;" FontSize="12" Visibility="Collapsed" />

                        <!-- Small Down Chevron -->
                        <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{StaticResource IvorySecondaryTextBrush}" />
                    </StackPanel>
                </Button>

                <!-- SECTION 1: ALBUM ARTWORK THUMBNAIL -->
                <Border Grid.Column="1"
                        Width="44"
                        Height="44"
                        CornerRadius="10"
                        Background="{StaticResource IvoryGlassMutedBrush}"
                        BorderBrush="{StaticResource IvoryBorderLavenderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <FontIcon x:Name="FallbackArtworkIcon"
                                  Glyph="&#xE8D6;"
                                  FontSize="18"
                                  Foreground="{StaticResource IvoryTertiaryTextBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        <Border CornerRadius="9">
                            <Image x:Name="AlbumArtworkImage"
                                   Width="44"
                                   Height="44"
                                   Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                </Border>

                <!-- SECTION 2: TRACK TITLE & ARTIST -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                    <TextBlock x:Name="TrackTitleTextBlock"
                               Text="No Active Media"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource IvoryPrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                    <TextBlock x:Name="ArtistSubtitleTextBlock"
                               Text="Play audio to begin"
                               FontSize="11"
                               Foreground="{StaticResource IvorySecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                </StackPanel>

                <!-- SECTION 3: TRANSPORT CONTROLS -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- Shuffle -->
                    <Button x:Name="ShuffleButton"
                            Width="26"
                            Height="26"
                            Style="{StaticResource CapsuleIconButtonStyle}"
                            Click="OnShuffleButtonClick"
                            ToolTipService.ToolTip="Toggle Shuffle">
                        <FontIcon x:Name="ShuffleIcon" Glyph="&#xE8B1;" FontSize="12" />
                    </Button>

                    <!-- Previous -->
                    <Button x:Name="PreviousButton"
                            Width="30"
                            Height="30"
                            Style="{StaticResource CapsuleIconButtonStyle}"
                            Click="OnPreviousButtonClick"
                            ToolTipService.ToolTip="Previous Track">
                        <FontIcon Glyph="&#xE892;" FontSize="13" />
                    </Button>

                    <!-- Play / Pause Circle Button -->
                    <Button x:Name="PlayPauseButton"
                            Style="{StaticResource FloatingPlayPauseButtonStyle}"
                            Click="OnPlayPauseButtonClick"
                            ToolTipService.ToolTip="Play / Pause">
                        <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="15" />
                    </Button>

                    <!-- Next -->
                    <Button x:Name="NextButton"
                            Width="30"
                            Height="30"
                            Style="{StaticResource CapsuleIconButtonStyle}"
                            Click="OnNextButtonClick"
                            ToolTipService.ToolTip="Next Track">
                        <FontIcon Glyph="&#xE893;" FontSize="13" />
                    </Button>

                    <!-- Repeat -->
                    <Button x:Name="RepeatButton"
                            Width="26"
                            Height="26"
                            Style="{StaticResource CapsuleIconButtonStyle}"
                            Click="OnRepeatButtonClick"
                            ToolTipService.ToolTip="Cycle Repeat">
                        <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="12" />
                    </Button>
                </StackPanel>

                <!-- SECTION 4: WAVEFORM / EQUALIZER VISUALIZER (Purple-to-Blue Gradient) -->
                <controls:EqualizerBarsControl x:Name="EqualizerControl"
                                              Grid.Column="4"
                                              VerticalAlignment="Center"
                                              Margin="4,0,4,0" />

                <!-- SECTION 5: VOLUME CONTROL -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Volume / Mute Speaker Icon -->
                    <Button x:Name="MuteButton"
                            Width="26"
                            Height="26"
                            Style="{StaticResource CapsuleIconButtonStyle}"
                            Click="OnMuteButtonClick"
                            ToolTipService.ToolTip="Mute / Unmute">
                        <FontIcon x:Name="VolumeIcon" Glyph="&#xE995;" FontSize="13" />
                    </Button>

                    <!-- Slim Volume Slider -->
                    <Slider x:Name="VolumeSlider"
                            Width="84"
                            Minimum="0"
                            Maximum="100"
                            StepFrequency="1"
                            Foreground="{StaticResource IvoryAccentVioletBrush}"
                            VerticalAlignment="Center"
                            ValueChanged="OnVolumeSliderValueChanged" />

                    <!-- Volume Percentage -->
                    <TextBlock x:Name="VolumePercentageTextBlock"
                               Text="70%"
                               Width="32"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource IvoryPrimaryTextBrush}"
                               VerticalAlignment="Center"
                               TextAlignment="Right" />
                </StackPanel>

                <!-- SECTION 6: DISMISS 'X' BUTTON (Right End) -->
                <Button x:Name="DismissButton"
                        Grid.Column="6"
                        Style="{StaticResource DismissCircleButtonStyle}"
                        Click="OnDismissButtonClick"
                        ToolTipService.ToolTip="Dismiss Floating Controller (Audio continues)"
                        AutomationProperties.Name="Dismiss Floating Controller">
                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                </Button>
            </Grid>
        </Border>

        <!-- Connected Quick Source Drawer -->
        <Border x:Name="SourceDrawerBorder"
                Grid.Row="1"
                Margin="0,6,0,0"
                Width="540"
                CornerRadius="18"
                Background="{StaticResource IvoryGlassSecondaryBrush}"
                BorderBrush="{StaticResource IvoryBorderBrush}"
                BorderThickness="1"
                Padding="16,12,16,12"
                Visibility="Collapsed"
                HorizontalAlignment="Center">
            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock Text="Available Media Sources" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource IvoryPrimaryTextBrush}" />
                    <TextBlock x:Name="DrawerSessionCountLabel" Text="2 active session(s)" FontSize="11" Foreground="{StaticResource IvorySecondaryTextBrush}" HorizontalAlignment="Right" />
                </Grid>

                <ListView x:Name="SessionsListView"
                          SelectionMode="Single"
                          MaxHeight="120"
                          ItemClick="OnSessionListItemClick"
                          IsItemClickEnabled="True">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaSessionSnapshot">
                            <Grid Padding="4,4,4,4" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{x:Bind Identity.GlyphCode}" FontSize="13" Foreground="{StaticResource IvoryPrimaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Identity.ApplicationDisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource IvoryPrimaryTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind DisplayTitle}" FontSize="11" Foreground="{StaticResource IvorySecondaryTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind PlaybackStatusText}" FontSize="10" Foreground="{StaticResource IvorySecondaryTextBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
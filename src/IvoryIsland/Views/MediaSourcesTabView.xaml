<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="IvoryIsland.Views.MediaSourcesTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:IvoryIsland.Models"
    FontFamily="{StaticResource IvoryPrimaryFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,24,32,32" Spacing="20" MaxWidth="800" HorizontalAlignment="Center">

            <!-- Active Sessions Card -->
            <Border CornerRadius="20"
                    Background="{StaticResource IvoryGlassSurfaceBrush}"
                    BorderBrush="{StaticResource IvoryBorderBrush}"
                    BorderThickness="1.2"
                    Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource IvoryAccentLavenderBrush}">
                                <FontIcon Glyph="&#xEC4F;" FontSize="16" Foreground="{StaticResource IvoryAccentVioletDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Discovered Media Sessions" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource IvoryPrimaryTextBrush}" />
                                <TextBlock x:Name="SessionCountSummaryText" Text="2 active session(s) detected via Windows GSMTC" FontSize="12" Foreground="{StaticResource IvorySecondaryTextBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="RefreshSessionsButton"
                                Style="{StaticResource GlassPillButtonStyle}"
                                HorizontalAlignment="Right"
                                Click="OnRefreshSessionsButtonClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock Text="Refresh" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Sessions ListView -->
                    <ListView x:Name="SessionsListView"
                              SelectionMode="Single"
                              ItemClick="OnSessionListItemClick"
                              IsItemClickEnabled="True">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaSessionSnapshot">
                                <Border CornerRadius="12"
                                        Background="{StaticResource IvoryGlassSecondaryBrush}"
                                        BorderBrush="{StaticResource IvoryBorderSubtleBrush}"
                                        BorderThickness="1"
                                        Padding="14,10,14,10"
                                        Margin="0,4,0,4">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- App Icon Badge -->
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{StaticResource IvoryGlassMutedBrush}">
                                            <FontIcon Glyph="{x:Bind Identity.GlyphCode}" FontSize="15" Foreground="{StaticResource IvoryPrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- App Name & Track Title -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Identity.ApplicationDisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource IvoryPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind DisplayTitle}" FontSize="12" Foreground="{StaticResource IvorySecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Playback Status Badge -->
                                        <Border Grid.Column="2"
                                                Height="22"
                                                CornerRadius="11"
                                                Background="{StaticResource IvoryGlassHoverBrush}"
                                                Padding="8,0,8,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind PlaybackStatusText}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource IvorySecondaryTextBrush}" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Switch Button -->
                                        <Button Grid.Column="3"
                                                Content="Switch"
                                                FontSize="11"
                                                Style="{StaticResource GlassPillButtonStyle}"
                                                Padding="10,4,10,4"
                                                VerticalAlignment="Center"
                                                Click="OnSessionSwitchButtonClick"
                                                Tag="{x:Bind SessionId}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Selection Policy Card -->
            <Border CornerRadius="20"
                    Background="{StaticResource IvoryGlassSecondaryBrush}"
                    BorderBrush="{StaticResource IvoryBorderBrush}"
                    BorderThickness="1"
                    Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="Session Selection Policy" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource IvoryPrimaryTextBrush}" />
                    <CheckBox x:Name="ManualLockCheckBox"
                              Content="Lock manual source selection (Prevent auto-switching on incoming media events)"
                              FontSize="12"
                              Click="OnManualLockCheckBoxClick" />
                    <TextBlock Text="Smart Stable mode keeps your chosen source active and only falls back if the current media player is closed."
                               FontSize="11"
                               Foreground="{StaticResource IvorySecondaryTextBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>